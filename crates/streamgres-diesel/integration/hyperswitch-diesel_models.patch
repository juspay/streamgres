+
+struct Row {
+    name: &'static str,
+    mode: String,
+    hit: bool,
+    equal_before: bool,
+    seen_in: Option<Duration>,
+    equal_after: bool,
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn every_model_lookup_matches_postgres_and_tracks_changes() {
+    let (Ok(database), Ok(s2s)) = (std::env::var("DATABASE_URL"), std::env::var("STREAMGRES_S2S_URL")) else {
+        eprintln!("DATABASE_URL / STREAMGRES_S2S_URL not set; skipping");
+        return;
+    };
+    // Writes go through a plain connection, so the window never applies;
+    // off anyway so nothing here depends on timing.
+    std::env::set_var("STREAMGRES_READ_YOUR_WRITES_MS", "0");
+
+    let engine = EngineClient::connect(s2s);
+    let cache = Arc::new(Cache::new(256 * 1024 * 1024, Arc::new(engine.clone())));
+    engine.attach(&cache);
+    let attached = cache.clone();
+    let _ = install(Settings::by_url(move |url| {
+        // The plain pool is the control: same alias, no cache.
+        (!url.contains("application_name=sgcov_plain")).then(|| Attachment {
+            cache: Arc::clone(&attached),
+            route: Route::Streamgres,
+        })
+    }));
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !engine.is_connected() {
+        assert!(Instant::now() < deadline, "the engine did not connect");
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+
+    let mut seeder = PgConnection::establish(&database).expect("connect");
+    seeder.batch_execute(SEED).expect("seed");
+
+    let separator = if database.contains('?') { '&' } else { '?' };
+    let plain_url = format!("{database}{separator}application_name=sgcov_plain");
+    let pool = |url: String| async move {
+        let manager = async_bb8_diesel::ConnectionManager::<DejaPgConnection>::new(&url);
+        bb8::Pool::builder().max_size(1).build(manager).await.expect("pool")
+    };
+    let synced_pool = pool(database.clone()).await;
+    let plain_pool = pool(plain_url).await;
+    let synced = DatabaseConnectionWithContext::new(synced_pool.get().await.expect("conn"), None, Arc::new(NoOpEventEmitter));
+    let plain = DatabaseConnectionWithContext::new(plain_pool.get().await.expect("conn"), None, Arc::new(NoOpEventEmitter));
+
+    let mut rows = Vec::new();
+    for case in cases() {
+        let subscribed = engine.subscribed();
+        let materialized = engine.materialized();
+        let refused = stat(&cache.stats.refused);
+        let fallbacks = engine.fallbacks().len();
+        let refusals = engine.refusals();
+
+        let on_plain = (case.run)(&plain).await;
+        let first = (case.run)(&synced).await;
+        let hits = stat(&cache.stats.hits);
+        let second = (case.run)(&synced).await;
+        let hit = stat(&cache.stats.hits) == hits + 1 && second == first;
+
+        let mode = if engine.subscribed() > subscribed {
+            if engine.materialized() > materialized {
+                "rows".to_string()
+            } else if engine.fallbacks().len() > fallbacks || engine.fallbacks().len() == 8 {
+                format!("refill: {}", engine.fallbacks().last().cloned().unwrap_or_default())
+            } else {
+                "refill".to_string()
+            }
+        } else if stat(&cache.stats.refused) > refused {
+            let why = engine.refusals();
+            let new = why.iter().filter(|r| !refusals.contains(r)).last().or(why.last());
+            format!("refused: {}", new.cloned().unwrap_or_default())
+        } else {
+            "not subscribed".to_string()
+        };
+        let equal_before = on_plain == first;
+
+        seeder.batch_execute(case.change).expect("change");
+        let started = Instant::now();
+        let mut seen_in = None;
+        let mut after = first.clone();
+        while started.elapsed() < Duration::from_secs(10) {
+            after = (case.run)(&synced).await;
+            if after != first {
+                seen_in = Some(started.elapsed());
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+        let on_plain_after = (case.run)(&plain).await;
+        let equal_after = on_plain_after == after;
+        if !equal_before || !equal_after {
+            eprintln!("\n{}\n  plain  : {on_plain}\n  synced : {first}\n  plain' : {on_plain_after}\n  synced': {after}", case.name);
+        }
+        rows.push(Row {
+            name: case.name,
+            mode,
+            hit,
+            equal_before,
+            seen_in,
+            equal_after,
+        });
+    }
+
+    eprintln!("\n{:<78} {:<60} {:>4} {:>6} {:>10} {:>6}", "case", "mode", "hit", "equal", "change", "equal'");
+    for row in &rows {
+        eprintln!(
+            "{:<78} {:<60} {:>4} {:>6} {:>10} {:>6}",
+            row.name,
+            row.mode.chars().take(60).collect::<String>(),
+            if row.hit { "yes" } else { "no" },
+            if row.equal_before { "yes" } else { "NO" },
+            row.seen_in.map(|d| format!("{:.1}ms", d.as_secs_f64() * 1000.0)).unwrap_or_else(|| "never".into()),
+            if row.equal_after { "yes" } else { "NO" },
+        );
+    }
+    eprintln!(
+        "\nsubscribed {} materialized {} refused {} hits {} touched {} replaced {}",
+        engine.subscribed(),
+        engine.materialized(),
+        stat(&cache.stats.refused),
+        stat(&cache.stats.hits),
+        stat(&cache.stats.touched),
+        stat(&cache.stats.replaced)
+    );
+
+    let wrong: Vec<&str> = rows.iter().filter(|r| !r.equal_before || !r.equal_after).map(|r| r.name).collect();
+    assert!(wrong.is_empty(), "answers differed from Postgres: {wrong:?}");
+    let stuck: Vec<&str> = rows.iter().filter(|r| r.seen_in.is_none()).map(|r| r.name).collect();
+    assert!(stuck.is_empty(), "changes never reached the synced answer: {stuck:?}");
+}
diff --git a/crates/diesel_models/tests/streamgres_live.rs b/crates/diesel_models/tests/streamgres_live.rs
new file mode 100644
index 0000000..26ef5fb
--- /dev/null
+++ b/crates/diesel_models/tests/streamgres_live.rs
@@ -0,0 +1,113 @@
+//! Hyperswitch's own config lookups through the Streamgres-synced
+//! connection, against a running engine.
+//!
+//! Needs `DATABASE_URL` (a database with the Hyperswitch schema that the
+//! engine streams) and `STREAMGRES_S2S_URL`; skips itself otherwise. Run
+//! with `--features v1,streamgres`.
+#![cfg(feature = "streamgres")]
+
+use std::sync::Arc;
+use std::sync::atomic::Ordering;
+use std::time::{Duration, Instant};
+
+use common_utils::external_service::NoOpEventEmitter;
+use diesel::prelude::*;
+use diesel_models::{
+    configs::{Config, ConfigNew, ConfigUpdate},
+    DatabaseConnectionWithContext, DejaPgConnection,
+};
+use streamgres_diesel::{cache::Cache, engine::EngineClient, install, Route, Settings};
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn config_lookups_are_served_from_the_synced_cache() {
+    let (Ok(database), Ok(s2s)) = (
+        std::env::var("DATABASE_URL"),
+        std::env::var("STREAMGRES_S2S_URL"),
+    ) else {
+        eprintln!("DATABASE_URL / STREAMGRES_S2S_URL not set; skipping");
+        return;
+    };
+
+    // The wrapper routes a connection's reads to Postgres for a second
+    // after it writes (read-your-writes). This test writes and reads on
+    // one connection on purpose, to watch the engine carry the change,
+    // so the window is off here.
+    std::env::set_var("STREAMGRES_READ_YOUR_WRITES_MS", "0");
+
+    // What a Hyperswitch binary would do at startup.
+    let engine = EngineClient::connect(s2s);
+    let cache = Arc::new(Cache::new(64 * 1024 * 1024, Arc::new(engine.clone())));
+    engine.attach(&cache);
+    let _ = install(Settings::single(cache.clone(), |_| Route::Streamgres));
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !engine.is_connected() {
+        assert!(Instant::now() < deadline, "the engine did not connect");
+        tokio::time::sleep(Duration::from_millis(50)).await;
+    }
+
+    // Hyperswitch's pool over its connection alias, now the synced wrapper.
+    let manager = async_bb8_diesel::ConnectionManager::<DejaPgConnection>::new(&database);
+    let pool = bb8::Pool::builder()
+        .max_size(2)
+        .build(manager)
+        .await
+        .expect("pool");
+    let pooled = pool.get().await.expect("connection");
+    let conn = DatabaseConnectionWithContext::new(pooled, None, Arc::new(NoOpEventEmitter));
+
+    let key = format!("sg-live-{}", std::process::id());
+    ConfigNew {
+        key: key.clone(),
+        config: "1".to_string(),
+    }
+    .insert(&conn)
+    .await
+    .expect("insert");
+
+    let first = Config::find_by_key(&conn, &key).await.expect("find");
+    assert_eq!(first.config, "1");
+    assert_eq!(engine.subscribed(), 1, "the engine follows Hyperswitch's lookup");
+    let second = Config::find_by_key(&conn, &key).await.expect("find again");
+    assert_eq!(second.config, "1");
+    assert_eq!(cache.stats.hits.load(Ordering::Relaxed), 1, "served from the cache");
+
+    // Hyperswitch's own update path: a write through the same connection,
+    // then the cached lookup catches up through the engine.
+    let started = Instant::now();
+    let updated = Config::update_by_key(
+        &conn,
+        &key,
+        ConfigUpdate::Update {
+            config: Some("2".to_string()),
+        },
+    )
+    .await
+    .expect("update");
+    assert_eq!(updated.config, "2", "the write returned the new row");
+    loop {
+        let seen = Config::find_by_key(&conn, &key).await.expect("find");
+        if seen.config == "2" {
+            break;
+        }
+        assert!(
+            started.elapsed() < Duration::from_secs(10),
+            "the update never reached the cached lookup"
+        );
+        tokio::time::sleep(Duration::from_millis(5)).await;
+    }
+    eprintln!("HYPERSWITCH update_by_key -> find_by_key sees it: {:?}", started.elapsed());
+    assert!(cache.stats.touched.load(Ordering::Relaxed) + cache.stats.replaced.load(Ordering::Relaxed) >= 1);
+    eprintln!("HYPERSWITCH rows mode: {}", engine.materialized() == 1);
+    assert_eq!(engine.subscribed(), 1);
+
+    // Clean up with a plain connection.
+    tokio::task::spawn_blocking(move || {
+        use diesel_models::schema::configs::dsl;
+        let mut plain = PgConnection::establish(&database).expect("connect");
+        diesel::delete(dsl::configs.filter(dsl::key.eq(&key)))
+            .execute(&mut plain)
+            .expect("delete");
+    })
+    .await
+    .expect("cleanup");
+}
