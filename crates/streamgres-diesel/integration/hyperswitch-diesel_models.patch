+//! Hyperswitch's own model lookups, one table after another, through the
+//! Streamgres-synced connection: what the engine does with each query
+//! shape, whether the wrapper's answer equals Postgres's, and how long a
+//! change takes to reach the cached answer.
+//!
+//! Every case runs the same model function on a plain connection and on
+//! the synced one, compares the results, changes the row behind it with
+//! raw SQL, waits for the synced answer to move, and compares again. The
+//! mode (rows, refill, refused) is reported, not asserted: it is what
+//! this test exists to find out. Equality is asserted.
+//!
+//! Needs `DATABASE_URL` (the Hyperswitch schema, streamed by an engine)
+//! and `STREAMGRES_S2S_URL`; skips itself otherwise. Run with
+//! `--features v1,streamgres -- --nocapture`.
+#![cfg(all(feature = "streamgres", feature = "v1"))]
+
+use std::borrow::Cow;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use common_utils::external_service::NoOpEventEmitter;
+use common_utils::id_type;
+use diesel::connection::SimpleConnection;
+use diesel::prelude::*;
+use diesel_models::{
+    address::Address, api_keys::ApiKey, business_profile::Profile, cards_info::CardInfo, configs::Config,
+    customers::Customer, events::Event, merchant_account::MerchantAccount,
+    merchant_connector_account::MerchantConnectorAccount, merchant_key_store::MerchantKeyStore,
+    organization::Organization, payment_attempt::PaymentAttempt, payment_intent::PaymentIntent,
+    process_tracker::ProcessTracker, refund::Refund, unified_translations::UnifiedTranslations,
+    DatabaseConnectionWithContext, DejaPgConnection,
+};
+use futures_util::future::BoxFuture;
+use streamgres_diesel::{cache::Cache, engine::EngineClient, install, Attachment, Route, Settings};
+
+type Conn<'a> = DatabaseConnectionWithContext<'a>;
+type Run = for<'a> fn(&'a Conn<'a>) -> BoxFuture<'a, String>;
+
+struct Case {
+    name: &'static str,
+    run: Run,
+    /// SQL that changes what the case reads.
+    change: &'static str,
+}
+
+fn stat(counter: &AtomicU64) -> u64 {
+    AtomicU64::load(counter, Ordering::Relaxed)
+}
+
+fn show<T: std::fmt::Debug, E: std::fmt::Display>(result: Result<T, E>) -> String {
+    match result {
+        Ok(value) => format!("{value:?}"),
+        Err(error) => format!("ERR {error}"),
+    }
+}
