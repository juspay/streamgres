# The sync server (`cargo run --release --bin server`) reads these. A `.env`
# in the working directory is read first; variables already set win.

# Where to listen, and the path prefix the Zero client connects under
# (the client's `server` option ends in this prefix).
XYNE_SYNC_ADDR=0.0.0.0:4848
XYNE_SYNC_BASE_PATH=/sync

# The database: the user needs replication rights and read access to every
# published table.
XYNE_SYNC_PG_DSN=postgresql://postgres:postgres@localhost:5432/xyne_dev_db
# Schemas whose tables the catalog carries; default: public and <app>_<shard>.
# XYNE_SYNC_SCHEMAS=public,xyne_0
# The permanent replication slot and its heartbeat.
XYNE_SYNC_SLOT=xyne_sync
XYNE_SYNC_HEARTBEAT_MS=1000
# How often a fresh exported snapshot (a temporary slot) is minted for reads.
XYNE_SYNC_SNAPSHOT_ROTATION_MS=1000
# How many storage reads may hold a Postgres connection at once; the rest queue.
XYNE_SYNC_READ_CONNECTIONS=16
# The most rows one storage read may return; a read past it is refused and
# the queries depending on it are told so (a query without a LIMIT over a
# large table would otherwise be buffered whole).
XYNE_SYNC_READ_ROW_LIMIT=100000
# How many threads run the storage reads (their SQL, connections and row
# decoding); the planner's counts and connect-time reads run there too.
XYNE_SYNC_READ_THREADS=2
# How many threads keep the client groups' views and build their pokes; each
# owns the groups that hash to it. One is enough for a few thousand groups;
# more spreads the fan-out over more cores.
XYNE_SYNC_GROUP_THREADS=1
# The most rows a join may read whole into memory on either side. An INNER
# edge is driven from the side that fits (the planner picks the driver per
# edge), and the query is refused when neither does. 0 turns the check off.
XYNE_SYNC_JOIN_LIMIT=100000
# Which side of an INNER edge drives it when both fit: parent (the query's own
# key-filtered rows; the child, usually an access rule over a whole table, is
# then read narrowed to the parent's join values) or child (the subquery, as
# The client's whereExists is translated).
XYNE_SYNC_JOIN_PREFERRED_SIDE=parent
# How long a join plan is remembered before its query is counted again, and
# how many plans are remembered at most (least recently used out).
XYNE_SYNC_PLAN_TTL_MS=600000
XYNE_SYNC_PLAN_CACHE=10000
# How long the application server's transform of a query (its AST) is kept
# per identity, so a shape asked for again does not pay the round trip, and
# how many are kept at most; 0 keeps none. A minute is the default: a deploy
# that changes a query's shape reaches clients within one. The reference server keeps
# its own for five seconds, which on the rig made a hydration about 8 ms
# slower at the median (twice the calls to the backend, each slower).
XYNE_SYNC_TRANSFORM_TTL_MS=60000
XYNE_SYNC_TRANSFORM_CACHE=20000
# A warm start: the query shapes asked for are kept in this file (written
# every minute and on shutdown) and planned again, for at most
# WARM_START_MS, before the next process reports ready; unset to keep none.
# XYNE_SYNC_PLAN_FILE=/var/lib/xyne-sync/plans.json
XYNE_SYNC_WARM_START_MS=20000
# Tables to mirror in memory instead of reading from Postgres (optional).
# XYNE_SYNC_MEMORY_TABLES=

# The application server: query names to ASTs, and mutations.
XYNE_SYNC_QUERY_URL=http://localhost:3001/api/sync/query
XYNE_SYNC_MUTATE_URL=http://localhost:3001/api/sync/push
XYNE_SYNC_FORWARD_COOKIES=true
# The application id and shard: together they name the schema the
# application server records mutations in (<app>_<shard>.clients).
XYNE_SYNC_APP_ID=xyne
XYNE_SYNC_SHARD=0

# The connection protocol. A `pong` answers every `ping`; when nothing has
# gone downstream for PONG_INTERVAL a `pong` goes out anyway; a WebSocket ping
# frame goes out every PING_INTERVAL; a connection silent for CLIENT_TIMEOUT
# is closed; a client group's subscriptions and its record of the rows it
# was sent outlive its last connection by GROUP_TTL (the default is a
# minute; an hour here), so a client back within it is caught up with what
# changed instead of downloading everything again. They live in memory: a
# restart of the server still starts every client afresh.
XYNE_SYNC_PONG_INTERVAL_MS=3000
XYNE_SYNC_PING_INTERVAL_MS=30000
XYNE_SYNC_CLIENT_TIMEOUT_MS=45000
XYNE_SYNC_GROUP_TTL_MS=3600000
XYNE_SYNC_MAX_MESSAGE_BYTES=16777216
XYNE_SYNC_ROWS_PER_PART=500

# error, warn, info or debug; text or json lines. Lines are written by a
# thread of their own from a bounded queue, so logging never waits.
XYNE_SYNC_LOG=info
XYNE_SYNC_LOG_FORMAT=text
# A query hydrating slower than this, or a push slower than this, is logged
# at warn with its name and timings.
XYNE_SYNC_SLOW_QUERY_MS=1000
# How often the metrics thread samples the process (resident set, CPU per
# thread, the caches); the summary log line goes out every sixth sample
# and /metrics serves everything in Prometheus format. 0 turns it off.
XYNE_SYNC_METRICS_INTERVAL_MS=10000
