# The sync server (`cargo run --release --bin server`) reads these. A `.env`
# in the working directory is read first; variables already set win.

# Where to listen, and the path prefix the Zero client connects under
# (the client's `server` option ends in this prefix).
XYNE_SYNC_ADDR=0.0.0.0:4848
XYNE_SYNC_BASE_PATH=/sync

# The database: the user needs replication rights and read access to every
# published table.
XYNE_SYNC_PG_DSN=postgresql://postgres:postgres@localhost:5432/xyne_dev_db
# Schemas whose tables the catalog carries; default: public and <app>_<shard>.
# XYNE_SYNC_SCHEMAS=public,xyne_0
# The permanent replication slot; its publication is `<slot>_pub`. Both are
# created at the first start only when they do not exist: create them
# yourself (the publication on the primary) and the server writes nothing to
# the database, so it can follow a primary, a logical replica or a physical
# standby (PostgreSQL 16 or later for a standby).
XYNE_SYNC_SLOT=xyne_sync
# Schema changes are heard through the reference server's DDL event trigger on
# `ddl_command_end` (`<app>_ddl_end_<shard>`), whose logical messages carry
# the prefix `<app>/<shard>/ddl`; the server refuses to start without the
# trigger. A table added, or a column added with no default or a constant
# one, is followed while the server runs; any other change to a served table
# stops the server, which restarts on the new schema (docs/deploy.md §4).
# XYNE_SYNC_DDL_TRIGGER=xyne_ddl_end_0
# XYNE_SYNC_DDL_PREFIX=xyne/0/ddl
# How often a fresh exported snapshot (a temporary slot) is minted for reads.
XYNE_SYNC_SNAPSHOT_ROTATION_MS=1000
# How many storage reads may hold a Postgres connection at once; the rest queue.
XYNE_SYNC_READ_CONNECTIONS=16
# How long one storage read may take (its connection opening included, the
# wait for a free connection not). PostgreSQL cancels the statement at that
# point and the server stops waiting; the query that needed the read is
# refused by name instead of being read again. 0 sets no limit.
XYNE_SYNC_READ_TIMEOUT_MS=10000
# TCP keepalive on every connection to the database: after this long without
# a byte either way the kernel probes the peer, so a NAT or a load balancer
# between does not drop the connection as idle. The temporary slot behind each
# read snapshot lives on an otherwise silent connection, and the snapshot dies
# with it. 0 turns the probing off.
XYNE_SYNC_PG_KEEPALIVE_IDLE_MS=30000
# After an unanswered probe, how long until the next one.
XYNE_SYNC_PG_KEEPALIVE_INTERVAL_MS=10000
# How many unanswered probes in a row before the kernel gives the connection up.
XYNE_SYNC_PG_KEEPALIVE_RETRIES=3
# The most rows the server reads into memory at once, one number for the
# planner and the storage: the planner reads whole no side of a join past it
# (an INNER edge is driven from the side that fits, the query is refused when
# neither does), and a storage read returning more is refused and the queries
# depending on it are told so (a query without a LIMIT over a large table
# would otherwise be buffered whole). The older names XYNE_SYNC_JOIN_LIMIT and
# XYNE_SYNC_READ_ROW_LIMIT are still read.
XYNE_SYNC_ROW_LIMIT=100000
# The most rows a page that drives an inner join is read whole for: within it
# the page's rows are all read in one go and the LIMIT applied in memory, so
# the join's restriction stays exact; past it the page is read in batches that
# double per round (ten times its limit or 100 at first, never more than the
# row limit, ten rounds at most), the rows the join rejects dropped.
XYNE_SYNC_WHOLE_PAGE_LIMIT=5000
# How many threads run the storage reads (their SQL, connections and row
# decoding); the planner's counts and connect-time reads run there too.
XYNE_SYNC_READ_THREADS=2
# How many threads keep the client groups' views and build their pokes; each
# owns the groups that hash to it. One is enough for a few thousand groups;
# more spreads the fan-out over more cores.
XYNE_SYNC_GROUP_THREADS=1
# Which side of an INNER edge drives it when the two count the same (the
# smaller side drives otherwise): parent (the query's own key-filtered rows;
# the child, usually an access rule over a whole table, is then read narrowed
# to the parent's join values) or child (the subquery, as the client's whereExists
# is translated).
XYNE_SYNC_JOIN_PREFERRED_SIDE=parent
# How long a join plan is remembered before its query is counted again, and
# how many plans are remembered at most (least recently used out).
XYNE_SYNC_PLAN_TTL_MS=600000
XYNE_SYNC_PLAN_CACHE=10000
# How long the application server's transform of a query (its AST) is kept
# per identity, so a shape asked for again does not pay the round trip, and
# how many are kept at most; 0 keeps none. A minute is the default: a deploy
# that changes a query's shape reaches clients within one. The reference server keeps
# its own for five seconds, which on the rig made a hydration about 8 ms
# slower at the median (twice the calls to the backend, each slower).
XYNE_SYNC_TRANSFORM_TTL_MS=60000
XYNE_SYNC_TRANSFORM_CACHE=20000
# A warm start: the query shapes asked for are kept in this file (written
# every minute and on shutdown) and planned again, for at most
# WARM_START_MS, before the next process reports ready; unset to keep none.
# XYNE_SYNC_PLAN_FILE=/var/lib/xyne-sync/plans.json
XYNE_SYNC_WARM_START_MS=20000
# Tables to mirror in memory instead of reading from Postgres (optional).
# XYNE_SYNC_MEMORY_TABLES=

# The application server: query names to ASTs, and mutations.
XYNE_SYNC_QUERY_URL=http://localhost:3001/api/sync/query
XYNE_SYNC_MUTATE_URL=http://localhost:3001/api/sync/push
XYNE_SYNC_FORWARD_COOKIES=true
# How long one call to the application server (a transform, a push) may take
# before it is given up; a call that timed out is not made again. 0 sets no
# limit.
XYNE_SYNC_BACKEND_TIMEOUT_MS=30000
# The application id and shard: together they name the schema the
# application server records mutations in (<app>_<shard>.clients).
XYNE_SYNC_APP_ID=xyne
XYNE_SYNC_SHARD=0

# The connection protocol. A `pong` answers every `ping`; when nothing has
# gone downstream for PONG_INTERVAL a `pong` goes out anyway; a WebSocket ping
# frame goes out every PING_INTERVAL; a connection silent for CLIENT_TIMEOUT
# is closed; a client group's subscriptions and its record of the rows it
# was sent outlive its last connection by GROUP_TTL (the default is a
# minute; an hour here), so a client back within it is caught up with what
# changed instead of downloading everything again: while no connection of
# the group is open its changes wait, coalesced, and its version stands
# still, so the cookie the client left with still fits. A client that
# returns behind its group (its socket died unnoticed while the server
# went on sending, or another tab kept the group moving) is sent the pokes
# it missed from the group's log: every poke sent is kept, the oldest
# dropped once they pass GROUP_LOG_BYTES per group (0 keeps none, and such
# a client starts over). All of
# it lives in memory: a restart of the server still starts every client
# afresh.
XYNE_SYNC_PONG_INTERVAL_MS=3000
XYNE_SYNC_PING_INTERVAL_MS=30000
XYNE_SYNC_CLIENT_TIMEOUT_MS=45000
XYNE_SYNC_GROUP_TTL_MS=3600000
XYNE_SYNC_GROUP_LOG_BYTES=262144
XYNE_SYNC_MAX_MESSAGE_BYTES=16777216
XYNE_SYNC_ROWS_PER_PART=500

# error, warn, info or debug; text or json lines. Lines are written by a
# thread of their own from a bounded queue, so logging never waits.
XYNE_SYNC_LOG=info
XYNE_SYNC_LOG_FORMAT=text
# A query hydrating slower than this, or a push slower than this, is logged
# at warn with its name and timings.
XYNE_SYNC_SLOW_QUERY_MS=1000
# How often the metrics thread samples the process (resident set, CPU per
# thread, the caches); the summary log line goes out every sixth sample
# and /metrics serves everything in Prometheus format. 0 turns it off.
XYNE_SYNC_METRICS_INTERVAL_MS=10000

# The push to an OpenTelemetry collector, configured by the variables
# the reference server is configured by (docs/observability.md section 5 has them
# all). Unset, nothing is pushed; /metrics and the log on stderr are always
# there. This is the block the sandbox gives the reference server: metrics every five
# seconds over OTLP/HTTP as JSON, logs left to stderr, no traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=none
# OTEL_TRACES_EXPORTER=none
# OTEL_METRIC_EXPORT_INTERVAL=5000
# OTEL_SERVICE_NAME=xyne-sync
